@inject InventarioSmt.Servicios.SesionUsuario Sesion
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario SMT</title>
    <link rel="stylesheet" href="~/css/fuentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Header" />

    <div class="principal">
        <main class="principal-main">
            <div class="overlay"></div>
            <div class="contenido">
                @RenderBody()
            </div>
        </main>
        <partial name="_Footer" />
    </div>

    <script src="~/js/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
